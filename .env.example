# Supabase production mode (default). Copy to .env.local.
VITE_PORTAL_MODE=production
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Older projects can use VITE_SUPABASE_ANON_KEY instead.
# Set VITE_PORTAL_MODE=demo for a separate fictional build.
